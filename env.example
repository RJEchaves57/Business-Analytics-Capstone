# Vercel API settings.
# Leave BACKEND_URL unset to run the Express backend inside the Vercel function
# (demo data lives in /tmp and resets on cold start).
# Set it to a hosted Express backend for persistent data. No trailing /api.
BACKEND_URL=http://127.0.0.1:3000

# Required in Vercel: long random string used to sign session cookies.
SESSION_SECRET=replace-with-a-long-random-value
